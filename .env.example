# API Key 只能由进程环境或受信任的 secret store 注入，不能写入 Skill 或配置模板。
UNIFYPORT_API_KEY=<api-key>
UNIFYPORT_ALLOW_WRITES=false
UNIFYPORT_ALLOW_DESTRUCTIVE=false

# Gateway 默认仅绑定 loopback；每个 /mcp 请求仍必须使用 Bearer API Key。
UNIFYPORT_GATEWAY_HOST=127.0.0.1
UNIFYPORT_GATEWAY_PORT=8787
UNIFYPORT_GATEWAY_PUBLIC=false
UNIFYPORT_GATEWAY_ALLOWED_HOSTS=
# 仅拒绝携带未批准 Origin 的请求；gateway 不返回 CORS headers，不支持浏览器 CORS。
UNIFYPORT_GATEWAY_ALLOWED_ORIGINS=

# 公网绑定时必须启用 PUBLIC、填写精确 host allowlist，并直接提供 TLS certificate/key。
# UNIFYPORT_GATEWAY_HOST=0.0.0.0
# UNIFYPORT_GATEWAY_PUBLIC=true
# UNIFYPORT_GATEWAY_ALLOWED_HOSTS=mcp.example.invalid
# UNIFYPORT_GATEWAY_ALLOWED_ORIGINS=https://app.example.invalid
# UNIFYPORT_GATEWAY_TLS_CERT_FILE=certs/gateway.crt
# UNIFYPORT_GATEWAY_TLS_KEY_FILE=certs/gateway.key
