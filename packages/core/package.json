{
  "name": "@unifyport/agent-core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Policy-gated runtime for UnifyPort Agent Skills.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unify-Port/UnifyPort-Agent-Skills.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@unifyport/sdk-node": "0.1.3",
    "ajv": "8.20.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
